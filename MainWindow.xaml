<Window x:Class="Sonja.ReadAloud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sonja Read Aloud"
        Width="820"
        Height="760"
        MinWidth="700"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        Loaded="Window_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="18" Padding="28" Margin="0,0,0,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF5CA8" Offset="0" />
                        <GradientStop Color="#D62E86" Offset="0.55" />
                        <GradientStop Color="#2A0A1C" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="SONJA" FontSize="12" FontWeight="Bold" Foreground="#FFC2E1" />
                        <TextBlock Text="Read selected text aloud" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,8" />
                        <TextBlock Text="Select text anywhere in Windows, then use one shortcut. Press it again to stop."
                                   Foreground="#F6D9E7" FontSize="14" TextWrapping="Wrap" MaxWidth="560" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="74" Height="74" CornerRadius="37" Background="#33FFFFFF" Margin="20,0,0,0">
                        <TextBlock Text="🔊" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="StatusBorder" Grid.Row="1" CornerRadius="10" Background="#22121B" BorderBrush="#472536" BorderThickness="1" Padding="16,12" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#67E8A5" Margin="0,0,12,0" />
                    <TextBlock x:Name="StatusText" Grid.Column="1" Text="Starting…" Foreground="#F0D6E4" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,0,0,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Shortcut" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="Click the field and press the new key combination. Include Ctrl, Alt, Shift, or Windows."
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,14" TextWrapping="Wrap" />
                    <Border Grid.Row="2" Background="#180C13" BorderBrush="#45283A" BorderThickness="1" CornerRadius="9" Padding="14,11">
                        <TextBox x:Name="HotkeyTextBox"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#FFFFFF"
                                 FontSize="17"
                                 FontWeight="SemiBold"
                                 Cursor="Hand"
                                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                 GotKeyboardFocus="HotkeyTextBox_GotKeyboardFocus"
                                 LostKeyboardFocus="HotkeyTextBox_LostKeyboardFocus" />
                    </Border>
                    <TextBlock x:Name="HotkeyHint" Grid.Row="3" Foreground="#B98BA6" Margin="2,9,0,0" Text="Shortcut is active system-wide." />
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,0,0,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Voice" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="Voice choices are loaded from your configured Azure Speech or Foundry TTS resource."
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,14" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="VoiceComboBox" IsEditable="True" IsTextSearchEnabled="True" DisplayMemberPath="DisplayName" />
                        <Button x:Name="RefreshVoicesButton" Grid.Column="1" Content="Refresh voices" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="RefreshVoicesButton_Click" />
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Speed" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Slider x:Name="RateSlider" Grid.Column="1" Minimum="-40" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="RateSlider_ValueChanged" />
                        <TextBlock x:Name="RateValueText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="0%" />
                    </Grid>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,20,0,0">
                        <Button x:Name="TestVoiceButton" Content="Test voice" Style="{StaticResource SecondaryButtonStyle}" Click="TestVoiceButton_Click" />
                        <TextBlock x:Name="ConnectionText" Foreground="#B98BA6" VerticalAlignment="Center" Margin="14,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Behavior" FontSize="18" FontWeight="SemiBold" />
                        <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Row="1" Content="Start Sonja when I sign in to Windows" Margin="0,16,0,0" />
                        <CheckBox x:Name="ShowNotificationsCheckBox" Grid.Row="2" Content="Show notifications when no readable selection is found" Margin="0,12,0,0" />
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="0,20,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Closing this window keeps Sonja running in the notification area."
                               Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,18,0" />
                    <Button Grid.Column="1" Content="Hide" Style="{StaticResource SecondaryButtonStyle}" Click="HideButton_Click" Margin="0,0,10,0" />
                    <Button x:Name="SaveButton" Grid.Column="2" Content="Save settings" Click="SaveButton_Click" />
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
