# Azure AI Speech credentials. Copy this file to .env and keep it private.
SPEECH_KEY=
SPEECH_REGION=

# Optional fallback when no region is available.
SPEECH_ENDPOINT=

# Optional Microsoft Foundry / Azure OpenAI TTS fallback.
AZURE_OPENAI_TTS_ENDPOINT=
AZURE_OPENAI_TTS_KEY=
AZURE_OPENAI_TTS_DEPLOYMENT=
AZURE_OPENAI_TTS_API_VERSION=2025-03-01-preview

# Optional final cloud voice fallback.
ELEVENLABS_API_KEY=